# Open WebUI
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.1
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=

# LM Studio / llmster
LMS_PORT=1234

# "auto" tries to bind only to Docker's host bridge on Linux.
# If Docker's bridge cannot be detected, the CLI falls back to 0.0.0.0 and warns.
LMS_BIND=auto

# Open WebUI -> LM Studio connection
OPENAI_API_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
